# Copy this file to config.env and fill it in (chmod 600 config.env),
# or run the setup wizard: .venv/bin/python configure.py
# Environment variables set at launch take precedence over this file.
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your_plex_token
PLEX_LIBRARIES=Movies,TV Shows
# "auto": each library's own language (as set in Plex), then English. Or a fixed list, e.g. fr-FR,en-US
PLEX_LANGUAGES=auto
# "yes": also replace Quebec posters in French libraries (same as --posters)
PLEX_POSTERS=no
# Webhooks for --notify, comma-separated (optional). Examples:
#   https://discord.com/api/webhooks/...          (Discord)
#   https://api.day.app/<your Bark key>            (Bark)
#   bark:https://my-bark-server.example/<key>      (self-hosted Bark)
#   json:https://example.org/hook                  (generic webhook, POST JSON)
NOTIFY_URLS=
# Uptime Kuma push URL (or healthchecks.io URL), pinged after every run (optional)
HEALTHCHECK_URL=
